+/**
+ * Nuvio Mod: the soft highlight used across the app (settings-page strength): white fill 7% and a
+ * sheen from the upper left at 8%, sized from the height so it looks the same on any width.
+ * [amount] fades it in and out.
+ */
+internal fun androidx.compose.ui.graphics.drawscope.DrawScope.drawModSoftHighlight(
+    outline: androidx.compose.ui.graphics.Outline,
+    amount: Float = 1f
+) {
+    if (amount <= 0f) return
+    drawOutline(outline, Color.White, alpha = 0.07f * amount)
+    drawOutline(
+        outline,
+        androidx.compose.ui.graphics.Brush.radialGradient(
+            0f to Color.White.copy(alpha = 0.08f * amount),
+            1f to Color.Transparent,
+            center = androidx.compose.ui.geometry.Offset(minOf(size.width * 0.28f, size.height * 1.12f), 0f),
+            radius = minOf(size.width * 0.75f, size.height * 3f).coerceAtLeast(1f)
+        )
+    )
+}
