+/**
+ * Nuvio Mod: the top menu pill's highlight (faint white fill + soft sheen from the upper left,
+ * no edge line), drawn behind the content when [focused].
+ */
+private fun Modifier.modMenuPillHighlight(focused: Boolean, shape: androidx.compose.ui.graphics.Shape): Modifier =
+    if (!focused) this else this.then(
+        Modifier.drawBehind {
+            val outline = shape.createOutline(size, layoutDirection, this)
+            drawOutline(outline, Color.White, alpha = 0.11f)
+            drawOutline(
+                outline,
+                androidx.compose.ui.graphics.Brush.radialGradient(
+                    0f to Color.White.copy(alpha = 0.11f),
+                    1f to Color.Transparent,
+                    center = androidx.compose.ui.geometry.Offset(size.width * 0.28f, 0f),
+                    radius = size.width.coerceAtLeast(1f) * 0.75f
+                )
+            )
+        }
+    )
