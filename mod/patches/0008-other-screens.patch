+package com.nuvio.tv.ui.screens.stream
+
+// Nuvio Mod: stream text lines made only of invisible characters (spaces, zero-width / format characters,
+// braille blank, Hangul fillers… used by addon formatters as hidden badge markers) take no room on the card.
+
+private val blankGlyphs = setOf(0x034F, 0x115F, 0x1160, 0x17B4, 0x17B5, 0x180E, 0x2800, 0x3164, 0xFFA0)
+
+private fun isInvisible(cp: Int): Boolean =
+    Character.isWhitespace(cp) || Character.isSpaceChar(cp) ||
+        Character.getType(cp) == Character.FORMAT.toInt() || cp in blankGlyphs ||
+        cp in 0xFE00..0xFE0F || cp in 0xE0100..0xE01EF // variation selectors
+
+/** True when the text would draw nothing. */
+fun String.modIsInvisible(): Boolean = codePoints().allMatch { isInvisible(it) }
+
+/** The text without its invisible-only lines; null when nothing visible is left. */
+fun String?.modVisibleLines(): String? =
+    this?.lines()?.filterNot { it.modIsInvisible() }?.joinToString("\n")?.takeIf { it.isNotEmpty() }
