@@ -0,0 +1,56 @@
+package com.nuvio.tv.ui.screens.profile
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.produceState
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import com.nuvio.tv.core.profile.PinAsk
+import com.nuvio.tv.core.profile.ProfileManager
+import com.nuvio.tv.core.profile.ProfileStartGate
+import kotlinx.coroutines.delay
+
+/*
+ * Nuvio Mod: with "Remember last profile" on, Arc still drew "Who's watching" for a few seconds at start (box,
+ * 2026-11-22: picker at ~3 s, then a black loader, Home at ~8 s). Its auto-select waits for the setting, "a profile
+ * was picked before" and the PIN states to load, which all read "no" until then, while the profile list (2 profiles)
+ * is already there. This keeps the start picture up instead, until Arc picks the remembered profile itself.
+ */
+
+/** How long the start picture may wait for Arc to pick the remembered profile before the list shows anyway. */
+private const val MOD_PROFILE_HOLD_MS = 4_000L
+
+/**
+ * True while "Who's watching" should not be drawn yet: the remembered profile is about to open (by [openRemembered]).
+ * False when the list is wanted (asked for, remember off, first start, a PIN asked at start, or too long).
+ */
+@Composable
+internal fun modHoldsProfilePicker(
+    profileManager: ProfileManager,
+    selectedThisSession: Boolean,
+    pickerRequested: Boolean,
+    signedOut: Boolean,
+    pinStates: Map<Int, Boolean>?,
+    pinAsks: Map<Int, PinAsk>,
+    openRemembered: () -> Unit
+): Boolean {
+    val remembered by produceState<Boolean?>(null, profileManager) { value = profileManager.modRemembersStart() }
+    val savedId by produceState<Int?>(null, profileManager) { value = profileManager.savedActiveProfileId() }
+    var tooLong by remember { mutableStateOf(false) }
+    LaunchedEffect(Unit) { delay(MOD_PROFILE_HOLD_MS); tooLong = true }
+    if (selectedThisSession || pickerRequested || tooLong) return false
+    return when (remembered) {
+        null -> true
+        false -> false
+        true -> {
+            val id = savedId ?: return true
+            val asksPin = ProfileStartGate.asksAtStart(ProfileStartGate.hasPin(signedOut, pinStates, id), pinAsks[id])
+            // No PIN asked: open it now. Arc's own check would, about 1 s later (box trace 2026-11-22: picked at
+            // +3.3 s, everything known at +2.2 s), and Home can't start before.
+            if (asksPin == false) LaunchedEffect(id) { openRemembered() }
+            asksPin != true // unknown yet: keep waiting; no PIN: opening; a PIN: show the list
+        }
+    }
+}
