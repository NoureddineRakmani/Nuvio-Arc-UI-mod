+/**
+ * Nuvio Mod: the pill under the remote. Mostly clear glass: a faint fill and a soft off-centre
+ * sheen from the upper left. No edge line. Drawn behind the label, so the text stays crisp.
+ */
+private fun Modifier.modNavFocusGlass(focused: Boolean): Modifier = if (!focused) this else drawBehind {
+    val radius = CornerRadius(size.height / 2f)
+    drawRoundRect(Color.White.copy(alpha = 0.07f), cornerRadius = radius)
+    // Light catching the upper left and fading across the pill, not a band along the top.
+    drawRoundRect(
+        Brush.radialGradient(
+            0f to Color.White.copy(alpha = 0.08f),
+            1f to Color.Transparent,
+            center = Offset(size.width * 0.28f, 0f),
+            radius = size.width * 0.75f
+        ),
+        cornerRadius = radius
+    )
+}
