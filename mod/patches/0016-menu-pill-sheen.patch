-// Nuvio Mod: how light the focused pill is. Same strength as the highlight in the rest of the app.
-private const val MOD_NAV_FOCUS_GLASS = 0.30f
+/**
+ * Nuvio Mod: the pill under the remote. Mostly clear glass: a faint fill, a soft sheen falling
+ * from the top, and a fine light edge. Drawn behind the label, so the text stays crisp.
+ */
+private fun Modifier.modNavFocusGlass(focused: Boolean): Modifier = if (!focused) this else drawBehind {
+    val radius = CornerRadius(size.height / 2f)
+    drawRoundRect(Color.White.copy(alpha = 0.11f), cornerRadius = radius)
+    drawRoundRect(
+        Brush.verticalGradient(
+            0f to Color.White.copy(alpha = 0.16f),
+            0.62f to Color.Transparent
+        ),
+        cornerRadius = radius
+    )
+    val line = 1.dp.toPx()
+    drawRoundRect(
+        Brush.verticalGradient(
+            listOf(Color.White.copy(alpha = 0.30f), Color.White.copy(alpha = 0.05f), Color.White.copy(alpha = 0.12f))
+        ),
+        topLeft = Offset(line / 2f, line / 2f),
+        size = Size(size.width - line, size.height - line),
+        cornerRadius = CornerRadius((size.height - line) / 2f),
+        style = Stroke(line)
+    )
+}
 
