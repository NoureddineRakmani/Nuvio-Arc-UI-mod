diff --git a/app/src/main/java/com/nuvio/tv/ui/screens/detail/ModHeroReserve.kt b/app/src/main/java/com/nuvio/tv/ui/screens/detail/ModHeroReserve.kt
new file mode 100644
index 0000000..ecd553e
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/ui/screens/detail/ModHeroReserve.kt
@@ -0,0 +1,104 @@
+package com.nuvio.tv.ui.screens.detail
+
+import android.content.Context
+import android.content.SharedPreferences
+import androidx.compose.foundation.layout.heightIn
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.layout.onSizeChanged
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.platform.LocalDensity
+
+/**
+ * Nuvio Mod: keeps the title page's top block still while it loads. That block is stacked from the
+ * bottom, so a row appearing under the logo pushes the logo up (measured on the TV: the ratings row and
+ * the source line each arrive 30-80 ms after the page and add about 57 px). Two fixes:
+ *  - the source line setting starts at its last known value instead of "off" while it loads;
+ *  - the ratings row's and the source line's room is kept (at their last measured height) while their
+ *    content loads.
+ * These values are kept on the device, so they also hold for the first title after the app starts.
+ * A title that ends up with no ratings (or no source) keeps that room empty.
+ */
+internal object ModHeroReserve {
+    private const val PREFS = "mod_hero_reserve"
+    private const val KEY_SOURCE_LINE = "source_line"
+    @Volatile private var prefs: SharedPreferences? = null
+
+    private fun prefs(context: Context): SharedPreferences =
+        prefs ?: context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE).also { prefs = it }
+
+    /** The source line setting as it was last time: the page's starting value while the setting loads. */
+    fun sourceLineStart(context: Context): Boolean = prefs(context).getBoolean(KEY_SOURCE_LINE, false)
+
+    /** Passes [on] through and keeps it for next time. */
+    fun sourceLine(context: Context, on: Boolean): Boolean {
+        val p = prefs(context)
+        if (p.getBoolean(KEY_SOURCE_LINE, false) != on) p.edit().putBoolean(KEY_SOURCE_LINE, on).apply()
+        return on
+    }
+
+    /** Where the title page's logo box ended last time (root px), for the next glide from Home. */
+    fun logoSlot(context: Context): androidx.compose.ui.geometry.Rect? {
+        val p = prefs(context)
+        if (!p.contains("logo_w")) return null
+        return androidx.compose.ui.geometry.Rect(p.getFloat("logo_l", 0f), p.getFloat("logo_t", 0f),
+            p.getFloat("logo_l", 0f) + p.getFloat("logo_w", 0f), p.getFloat("logo_t", 0f) + p.getFloat("logo_h", 0f))
+    }
+
+    fun saveLogoSlot(context: Context, slot: androidx.compose.ui.geometry.Rect) {
+        prefs(context).edit().putFloat("logo_l", slot.left).putFloat("logo_t", slot.top)
+            .putFloat("logo_w", slot.width).putFloat("logo_h", slot.height).apply()
+    }
+
+    /** A point kept by name (root px): where a part of the title page ended last time. */
+    fun point(context: Context, name: String): androidx.compose.ui.geometry.Offset? {
+        val p = prefs(context)
+        if (!p.contains("pt_${name}_x")) return null
+        return androidx.compose.ui.geometry.Offset(p.getFloat("pt_${name}_x", 0f), p.getFloat("pt_${name}_y", 0f))
+    }
+
+    fun savePoint(context: Context, name: String, at: androidx.compose.ui.geometry.Offset) {
+        prefs(context).edit().putFloat("pt_${name}_x", at.x).putFloat("pt_${name}_y", at.y).apply()
+    }
+
+    /**
+     * On the holder of a late row ([name]: "ratings", "source"): measures it when it shows ([shown]);
+     * keeps that room while its content is [loading].
+     */
+    @Composable
+    fun Modifier.modLateRowRoom(name: String, loading: Boolean, shown: Boolean): Modifier {
+        val context = LocalContext.current
+        val density = LocalDensity.current
+        val key = "${name}_px"
+        val room = remember(key) { prefs(context).getInt(key, 0) }
+        val measure = onSizeChanged { size ->
+            if (shown && size.height > 0) {
+                val p = prefs(context)
+                if (p.getInt(key, 0) != size.height) p.edit().putInt(key, size.height).apply()
+            }
+        }
+        return if (loading && room > 0) then(measure).heightIn(min = with(density) { room.toDp() }) else then(measure)
+    }
+
+    /** Stands in for a late row ([name]) that has nothing to show yet: an empty space of its last measured height (v2 look). */
+    @Composable
+    fun LateRowRoom(name: String) {
+        if (com.nuvio.tv.ui.v2.appearance.LocalV2Appearance.current == null) return
+        val context = LocalContext.current
+        val px = remember(name) { prefs(context).getInt("${name}_px", 0) }
+        if (px <= 0) return
+        androidx.compose.foundation.layout.Spacer(Modifier.heightIn(min = with(LocalDensity.current) { px.toDp() }))
+    }
+
+    /** A number kept by name, for the title page's measurements (see ModHeroFlight). */
+    fun number(context: Context, name: String): Float? {
+        val p = prefs(context)
+        return if (p.contains("n_$name")) p.getFloat("n_$name", 0f) else null
+    }
+
+    fun saveNumber(context: Context, name: String, value: Float) {
+        val p = prefs(context)
+        if (p.getFloat("n_$name", Float.NaN) != value) p.edit().putFloat("n_$name", value).apply()
+    }
