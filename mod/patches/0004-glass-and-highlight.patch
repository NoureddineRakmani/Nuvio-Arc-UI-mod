-fun Modifier.nuvioV2Focus(focused: Boolean, shape: Shape, accentOverride: Color? = null, hardwareShadow: Boolean = true, stationary: Boolean = false): Modifier {
+fun Modifier.nuvioV2Focus(focused: Boolean, shape: Shape, accentOverride: Color? = null, hardwareShadow: Boolean = true, stationary: Boolean = false, wash: Boolean = true): Modifier {
+    if (stationary && !focused) return this
+    val appearance = LocalV2Appearance.current ?: return this
+    // Nuvio Mod: the player keeps Arc's own focus look.
+    if (com.nuvio.tv.ui.v2.appearance.LocalResolvedAppearance.current?.playbackActive == true) {
+        return nuvioV2FocusArc(focused, shape, accentOverride, hardwareShadow, stationary)
+    }
+    // Nuvio Mod: same idea as the top menu bar. The focused item gets a neutral white highlight;
+    // no coloured ring, no glow, no moving glints, no lift. Items that move still grow slightly.
+    val transform = FocusTransform.forStyle(appearance.focusStyle)
+    val shadowDp = LocalGlassTokens.current.shadowDp
+    val density = LocalDensity.current
+    val progress = animateFloatAsState(
+        targetValue = if (focused) 1f else 0f,
+        animationSpec = if (stationary) androidx.compose.animation.core.snap()
+            else tween(if (focused) V2Motion.FocusResponseMs else V2Motion.FocusSettleMs),
+        label = "modV2Focus"
+    )
+    val transformLayer = if (stationary) Modifier else Modifier.graphicsLayer {
+        val p = progress.value
+        scaleX = 1f + (transform.scale - 1f) * p
+        scaleY = scaleX
+        shadowElevation = if (hardwareShadow) shadowDp * density.density * p else 0f
+        this.shape = shape
+        clip = false
+        ambientShadowColor = Color.Black
+        spotShadowColor = Color.Black
+    }
+    if (!wash) return then(transformLayer)
+    return then(transformLayer).drawWithCache {
+        val outline = shape.createOutline(size, layoutDirection, this)
+        onDrawWithContent {
+            drawContent()
+            drawModSoftHighlight(outline, progress.value)
+        }
+    }
+}
