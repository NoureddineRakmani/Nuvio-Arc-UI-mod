+package com.nuvio.tv.ui.v2.components
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableLongStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.runtime.withFrameNanos
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawWithContent
+
+/**
+ * Nuvio Mod: the details page keeps its frosted glass while a trailer plays (Arc turns it plain).
+ * The trailer joins the glass source and is re-captured ~30 times a second, like Arc's Home hero at Maximum.
+ */
+object ModTrailerGlass {
+    /** True while a details trailer is part of the glass source: glass keeps blurring and refreshes with the video. */
+    var live by mutableStateOf(false)
+        private set
+
+    @Composable
+    fun Modifier.modTrailerGlassSource(playing: Boolean): Modifier {
+        val frame = remember { mutableLongStateOf(0L) }
+        val on = playing
+        LaunchedEffect(on) {
+            if (!on) return@LaunchedEffect
+            var last = 0L
+            while (true) withFrameNanos { now -> if (now - last >= 33_000_000L) { frame.longValue = now; last = now } }
+        }
+        DisposableEffect(on) { live = on; onDispose { if (on) live = false } }
+        return if (on) v2GlassSource().drawWithContent { frame.longValue; drawContent() } else this
+    }
+}
