+// Nuvio Mod: one glass for the whole app, the same as the top menu bar.
+private val MOD_GLASS_TINT = Color(0xFF161618)
+private const val MOD_GLASS_FROSTED_ALPHA = 0.65f   // over a blurred background (same as the menu bar)
+private const val MOD_GLASS_PLAIN_ALPHA = 0.94f     // when there is nothing to blur
+
 @Composable
 fun Modifier.nuvioGlass(
     role: GlassRole,
@@ -89,6 +94,78 @@ fun Modifier.nuvioGlass(
     hazeState: HazeState? = null,
     trailingEdgeOnly: Boolean = false,
     neutralBackdrop: Boolean = false
+): Modifier {
+    // Nuvio Mod: the player keeps Arc's own glass (nothing is blurred over a playing video).
+    val playbackActive = com.nuvio.tv.ui.v2.appearance.LocalResolvedAppearance.current?.playbackActive == true
+    return if (playbackActive) nuvioGlassArc(role, focused, shape, hazeState, trailingEdgeOnly, neutralBackdrop)
+    else nuvioGlassMod(role, focused, shape, hazeState, neutralBackdrop)
+}
+
+/**
+ * Nuvio Mod: flat dark frosted glass. No rim lines, no reflections, no colour tint.
+ * Blur is on or off following Arc's glass blur setting and quality level; its look is the menu bar's.
+ */
+@Composable
+private fun Modifier.nuvioGlassMod(
+    role: GlassRole,
+    focused: Boolean,
+    shape: Shape,
+    hazeState: HazeState?,
+    neutralBackdrop: Boolean
+): Modifier {
+    val appearance = LocalV2Appearance.current
+    val tokens = LocalGlassTokens.current
+    val dark = appearance?.visualStyle == VisualStyle.PURE_LIQUID_DARK
+    val popupBackdrop = LocalPopupGlassBackdrop.current
+    val capturePopup = role == GlassRole.MODAL && !dark && tokens.liveBlur
+    DisposableEffect(popupBackdrop, capturePopup) {
+        if (capturePopup) popupBackdrop?.attach()
+        onDispose { if (capturePopup) popupBackdrop?.detach() }
+    }
+    val backdrop = if (role == GlassRole.MODAL) popupBackdrop?.state else LocalGlassBackdrop.current
+    val cinematic = appearance?.visualStyle == VisualStyle.CINEMATIC_GLASS
+    // A trailer playing behind a surface cannot be blurred: the surface turns plain instead.
+    val smoke = LocalGlassVideoSmoke.current.takeIf { cinematic && role != GlassRole.MODAL }
+    val smoked = if (smoke != null) remember(smoke) { derivedStateOf { smoke.value >= 1f } }.value else false
+    val source = (hazeState ?: backdrop).takeIf {
+        !smoked && !neutralBackdrop && !dark && tokens.liveBlur && role != GlassRole.CARD_FOCUS &&
+            (it === popupBackdrop?.state || it?.areas?.isNotEmpty() == true)
+    }
+    val panelBlur = NuvioTheme.effects.blurPanel
+    val refreshVideo = tokens.edgeLayers >= 3 && (popupBackdrop?.liveTrailers ?: 0) > 0
+    val blur = if (source != null) Modifier.hazeEffect(state = source) {
+        backgroundColor = Color(0xFF080A0C)
+        blurRadius = panelBlur
+        noiseFactor = 0f // Nuvio Mod: no grain in the frosted glass
+        inputScale = HazeInputScale.Fixed(0.66f)
+        forceInvalidateOnPreDraw = refreshVideo
+    } else Modifier
+    val bodyAlpha = if (source != null) MOD_GLASS_FROSTED_ALPHA else MOD_GLASS_PLAIN_ALPHA
+    return clip(shape)
+        .then(blur)
+        .background(MOD_GLASS_TINT.copy(alpha = bodyAlpha), shape)
+        .drawWithCache {
+            val outline = shape.createOutline(size, layoutDirection, this)
+            onDrawWithContent {
+                val smokeAmount = smoke?.value ?: 0f
+                if (smokeAmount > 0f && bodyAlpha < MOD_GLASS_PLAIN_ALPHA) {
+                    drawOutline(outline, MOD_GLASS_TINT, alpha = 0.8f * smokeAmount)
+                }
+                if (focused) drawModSoftHighlight(outline) // Nuvio Mod: same soft highlight as settings
+                drawContent()
+            }
+        }
+}
+
