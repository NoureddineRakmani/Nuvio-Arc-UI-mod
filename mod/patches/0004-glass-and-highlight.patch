+/**
+ * Nuvio Mod: the one place that defines the mod's look. Every screen reads these values, so a
+ * change here changes the whole app (the player keeps Arc's own look).
+ */
+object ModLook {
+    /** Focus highlight: flat white fill. */
+    const val FILL = 0.05f
+    /** Focus highlight: soft sheen from the upper left, on top of the fill. */
+    const val SHEEN = 0.06f
+    /** Selected but not focused (current page, chosen option): flat white pane. */
+    const val SELECTED = 0.03f
+    /** How much posters, photos and other picture cards grow on focus. */
+    const val GROW = 1.06f
+
+    val Selected: Color = Color.White.copy(alpha = SELECTED)
+    val FocusFill: Color = Color.White.copy(alpha = FILL)
+
+    /** Corner used by buttons, rows, tabs and option cards. */
+    val Corner = RoundedCornerShape(12.dp)
+    val Pill = RoundedCornerShape(50)
+}
+
+/**
+ * The highlight itself: fill + sheen, no edge line. The sheen is sized from the height, so it looks
+ * the same on a wide row as on a small pill. [amount] fades it in and out; [fill] = false draws the
+ * sheen only (for items whose own background already turns into [ModLook.FocusFill] on focus).
+ */
+internal fun DrawScope.drawModSoftHighlight(outline: Outline, amount: Float = 1f, fill: Boolean = true) {
+    if (amount <= 0f) return
+    if (fill) drawOutline(outline, Color.White, alpha = ModLook.FILL * amount)
+    drawOutline(
+        outline,
+        Brush.radialGradient(
+            0f to Color.White.copy(alpha = ModLook.SHEEN * amount),
+            1f to Color.Transparent,
+            center = Offset(minOf(size.width * 0.28f, size.height * 1.12f), 0f),
+            radius = minOf(size.width * 0.75f, size.height * 3f).coerceAtLeast(1f)
+        )
+    )
+}
+
+/** Highlight behind the content, for items that already know whether they are focused. */
+fun Modifier.modPillHighlight(focused: Boolean, shape: Shape, fill: Boolean = true): Modifier =
+    if (!focused) this else drawBehind {
+        drawModSoftHighlight(shape.createOutline(size, layoutDirection, this), fill = fill)
+    }
+
+/**
+ * Highlight for an existing card or button that draws its own background: it tracks focus by itself
+ * and draws the highlight over the item. Does nothing outside the Nuvio v2 interface.
+ */
+@Composable
+fun Modifier.modFocusHighlight(shape: Shape = ModLook.Corner, fill: Boolean = true): Modifier {
+    if (LocalV2Appearance.current == null) return this
+    var focused by remember { mutableStateOf(false) }
+    return onFocusChanged { focused = it.isFocused }.drawWithContent {
+        drawContent()
+        if (focused) drawModSoftHighlight(shape.createOutline(size, layoutDirection, this), fill = fill)
+    }
+}
+
+/** Arc's coloured focus ring, switched off in the Nuvio v2 interface (the highlight replaces it). */
+@Composable
+fun modNoRingInV2(stroke: BorderStroke): BorderStroke =
+    if (LocalV2Appearance.current != null) BorderStroke(stroke.width, Color.Transparent) else stroke
+
+/**
+ * A plain text button. In Nuvio v2 it is the same glass button as on the details page; otherwise it
+ * is Arc's original button, with [colors] if the screen set any.
+ */
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+fun ModPlainButton(
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+    colors: ButtonColors? = null,
+    content: @Composable RowScope.() -> Unit
+) {
+    if (LocalV2Appearance.current != null) {
+        NuvioActionPill(onClick = onClick, modifier = modifier, enabled = enabled, stationary = true, content = content)
+    } else if (colors != null) {
+        Button(onClick = onClick, modifier = modifier, enabled = enabled, colors = colors, content = content)
+    } else {
+        Button(onClick = onClick, modifier = modifier, enabled = enabled, content = content)
+    }
+}
