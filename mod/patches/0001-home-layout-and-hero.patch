 internal val shownHeroImage = ShownHeroMemory<coil3.Image>()
 
+/** Nuvio Mod: the title the kept hero image belongs to, so it is never shown for another title. */
+@Volatile internal var modShownHeroOwner: String? = null
+
+/**
+ * Nuvio Mod: Home's hero picture (address + decoded picture) if it is showing [itemId] right now.
+ * The title on the hero card is known from [modRecordHeroCard]. Fallback for a card not recorded yet:
+ * catalog card keys built as "catalog_<row>_<id>_<occurrence>" end in "_<id>" before the last "_".
+ */
+internal fun modShownHeroFor(itemId: String): Pair<String, coil3.Image>? {
+    val owner = modShownHeroOwner ?: return null
+    val ids = modHeroOwnerIds[owner]
+    val matches = (ids != null && itemId in ids) || owner.substringBeforeLast('_').endsWith("_$itemId")
+    if (!matches) return null
+    return shownHeroImage.lastWithUrl()
+}
+
+/**
+ * Nuvio Mod: hero card key -> the IDs of the title on that card, recorded when Home picks its hero
+ * card. Small and bounded: only the last few cards are kept.
+ */
+private val modHeroOwnerIds = java.util.Collections.synchronizedMap(
+    object : LinkedHashMap<String, Set<String>>(16, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<String, Set<String>>?) = size > 12
+    }
+)
+
+internal fun modRecordHeroCard(item: ModernCarouselItem?) {
+    if (item == null) return
+    val ids = buildSet {
+        item.metaPreview?.id?.let { add(it) }
+        when (val p = item.payload) {
+            is ModernPayload.Catalog -> add(p.itemId)
+            is ModernPayload.ContinueWatching -> when (val cw = p.item) {
+                is ContinueWatchingItem.InProgress -> add(cw.progress.contentId)
+                is ContinueWatchingItem.NextUp -> add(cw.info.contentId)
+            }
+            else -> Unit
+        }
+    }.filter(String::isNotBlank).toSet()
+    if (ids.isNotEmpty()) modHeroOwnerIds[item.key] = ids
+}
+
+/**
+ * Nuvio Mod: Home's hero picture handed to the streams screen opened from a Home card of that title, so its loading
+ * screen starts on the picture instead of black while it loads the picture again. Taken once, only by that title.
+ */
+internal object ModStreamSeed {
+    private class Seed(val id: String, val image: coil3.Image)
+    @Volatile private var seed: Seed? = null
+
+    fun offerFromHome(contentId: String) {
+        seed = modShownHeroFor(contentId)?.let { Seed(contentId, it.second) }
+    }
+
+    fun offerFromHome(item: ContinueWatchingItem) = offerFromHome(
+        when (item) {
+            is ContinueWatchingItem.InProgress -> item.progress.contentId
+            is ContinueWatchingItem.NextUp -> item.info.contentId
+        }
+    )
+
+    fun take(contentId: String?): coil3.Image? {
+        val current = seed
+        seed = null
+        return current?.takeIf { contentId != null && it.id == contentId }?.image
+    }
+}
+
+/**
+ * Nuvio Mod: the exact picture Home was showing for the title being opened. The details page draws
+ * it from its first frame until its own backdrop has loaded, so it never opens on a dark screen.
+ * Taken once, and only by the page of that same title.
+ */
+internal object ModDetailSeed {
+    private class Seed(val id: String, val type: String, val image: coil3.Image)
+    @Volatile private var seed: Seed? = null
+
+    fun offer(id: String, type: String, image: coil3.Image?) {
+        seed = image?.let { Seed(id, type, it) }
+    }
+
+    fun take(id: String?, type: String?): coil3.Image? {
+        val current = seed
+        seed = null
+        return current?.takeIf { it.id == id && it.type == type }?.image
+    }
+}
