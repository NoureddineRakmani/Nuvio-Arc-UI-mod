+
+    /**
+     * Parts shown on both screens (description, ratings row): each glides from its place on Home to its place
+     * on the page, from the press; when the page is there, Home's copy cross-fades into the page's at the
+     * same moving spot (the page's description wraps to its own width, its ratings row shows all ratings).
+     */
+    /** [belowDescription]: laid out under the page's description, so its place depends on the description's height. */
+    enum class Piece(val belowDescription: Boolean) { DESCRIPTION(false), RATINGS(true), DATE(false), GENRE(false), RUNTIME(false) } // Nuvio Mod: date/genre line above the description, ratings under it
+    /** Learned places are kept under these names (her order: buttons, genre line, badges, description, ratings). */
+    private val Piece.key get() = name + "_v4"
+
+    private class PieceState {
+        var homeCoords: LayoutCoordinates? = null
+        var pageCoords: LayoutCoordinates? = null
+        /** Home's copy when the card was pressed (root px), and where the move aims (the page's copy once known). */
+        var from: Offset? = null
+        var aim: Offset? = null
+        var lastAim: Offset? = null
+        /** How far below its box the page's copy draws its content (px), so both copies line up while they cross. */
+        var pageInsetY = 0f
+        val drift = Animatable(Offset.Zero, Offset.VectorConverter)
+        var driftJob: Job? = null
+        /** How much bigger the page's copy is than Home's (both copies are scaled alike as they glide). */
+        var growX = 1f
+        var growY = 1f
+        /** Home's text and style, and the page's style, for pieces whose size is measured. */
+        var homeText: String? = null
+        var homeStyle: TextStyle? = null
+        var pageStyle: TextStyle? = null
+        /** Home's copy's width when the move started (px): the part of the page's copy shown before it opens out. */
+        var homeWidth = 0f
+        /** Home's whole genre list, as the page writes it (the genre piece only). */
+        var homeFullText: String? = null
+    }
+    private val pieces = Piece.entries.associateWith { PieceState() }
+    /** Home's description when the card was pressed (to know the page's description size before it opens). */
+    private var homeDescription: String? = null
+    /** To measure a description as the title page lays it out (captured on Home). */
+    private var measurer: TextMeasurer? = null
+    private var descStyle: TextStyle? = null
+    private var density: Density? = null
+    /**
+     * Some catalogs give the page a different description first (another line long) and the final one with the
+     * full details. While the page's text differs from Home's, its box keeps the height predicted from Home's
+     * text (which the final one has), for at most [DESC_HOLD_MS] after the press, so the block doesn't move.
+     */
+    private var descHold by mutableStateOf<Float?>(null)
+    private var descHoldId: String? = null
+    private var descHoldText: String? = null
+    private var descHoldJob: Job? = null
+    private const val DESC_HOLD_MS = 1500L
+
+    private fun clearDescHold() {
+        descHoldJob?.cancel()
+        descHoldJob = null
+        descHold = null
+        descHoldId = null
+        descHoldText = null
+    }
+
+    /** The latest title page's logo box top and description box height (px), to learn the block's bottom line. */
+    private var pageLogoTop: Float? = null
+    private var pageDescHeight: Float? = null
+
+    /** The page's block under the logo, before and inside its own move (to read where its parts are laid out). */
+    private var pageBlockOuter: LayoutCoordinates? = null
+    private var pageBlockInner: LayoutCoordinates? = null
+
+    // ---- Home ------------------------------------------------------------------------------
+
+    /** On Home's logo picture: remembers where it is drawn; glides until the page's logo takes over. */
+    @Composable
+    fun Modifier.modFlightHomeLogo(image: coil3.Image): Modifier {
+        if (LocalV2Appearance.current == null) return this
+        appContext = LocalContext.current.applicationContext
+        measurer = rememberTextMeasurer()
+        descStyle = androidx.tv.material3.MaterialTheme.typography.bodyMedium
+        pieces.getValue(Piece.DATE).pageStyle = androidx.tv.material3.MaterialTheme.typography.labelLarge // the page's date line
+        pieces.getValue(Piece.GENRE).pageStyle = androidx.tv.material3.MaterialTheme.typography.labelLarge // and its genres
+        pieces.getValue(Piece.RUNTIME).pageStyle = androidx.tv.material3.MaterialTheme.typography.labelLarge // Nuvio Mod: and its duration
+        density = LocalDensity.current
+        genreGapPx = with(LocalDensity.current) { com.nuvio.tv.ui.theme.NuvioTheme.spacing.md.toPx() } // the page's gap after its genres
+        DisposableEffect(Unit) { onDispose { homeLogo = null; homeNode = null } }
+        return onGloballyPositioned { c ->
+            val pos = c.positionInRoot()
+            homeNode = pos
+            homeLogo = fitStart(c.size.toSize(), image.width.toFloat(), image.height.toFloat())?.translate(pos)
+        }.graphicsLayer {
+            if (phase != Phase.Flying) return@graphicsLayer
+            if (pageReady) { alpha = 0f; return@graphicsLayer }
+            val src = from ?: return@graphicsLayer
+            val node = fromNode ?: return@graphicsLayer
+            val r = flightRect() ?: return@graphicsLayer
+            val k = r.width / src.width
+            transformOrigin = TransformOrigin(0f, 0f)
+            scaleX = k
+            scaleY = k
+            translationX = r.left - node.x - k * (src.left - node.x)
+            translationY = r.top - node.y - k * (src.top - node.y)
+        }
+    }
+
+    private fun homeAlpha(): Float = (1f - progress.value / HOME_GONE_AT).coerceIn(0f, 1f)
+
+    /** On Home's rows: fade out as the move goes. */
+    fun Modifier.modFlightHomeForeground(): Modifier = graphicsLayer {
+        alpha = if (phase == Phase.Flying) homeAlpha() else 1f
+    }
+
+    /** How far Home's texts under the logo have moved with it (its bottom-left corner). */
+    private fun homeTextShift(): Offset? {
+        val src = from ?: return null
+        val r = flightRect() ?: return null
+        return Offset(r.left - src.left, r.bottom - src.bottom)
+    }
+
+    /** On Home's texts under the logo: leave as one piece with the logo; hand over to the page's when it's there. */
+    fun Modifier.modFlightHomeText(): Modifier = graphicsLayer {
+        if (phase != Phase.Flying) return@graphicsLayer
+        alpha = if (pageReady) 1f - handoff.value else 1f
+        val shift = homeTextShift() ?: return@graphicsLayer
+        translationX = shift.x
+        translationY = shift.y
+    }
+
+    /** On Home's lines under the title, except the gliding pieces: gone before the description glides over them. */
+    fun Modifier.modFlightHomeLeaving(): Modifier = graphicsLayer {
+        if (phase == Phase.Flying) alpha = (1f - progress.value / HOME_LINES_GONE_AT).coerceIn(0f, 1f)
+    }
+
+    /** On Home's copy of a [piece]; [movesWithLogo] when it sits inside [modFlightHomeText]; [text]: the description's. */
+    fun Modifier.modFlightHomePiece(piece: Piece, movesWithLogo: Boolean, text: String? = null, style: TextStyle? = null, fullText: String? = null): Modifier {
+        val st = pieces.getValue(piece)
+        return onGloballyPositioned {
+            st.homeCoords = it
+            st.homeText = text
+            st.homeFullText = fullText
+            st.homeStyle = style
+            if (piece == Piece.DESCRIPTION) homeDescription = text
+        }.graphicsLayer {
+            if (phase != Phase.Flying) return@graphicsLayer
+            if (!movesWithLogo && pageReady) alpha = 1f - handoff.value
+            val start = st.from ?: return@graphicsLayer
+            val pos = piecePos(st) ?: return@graphicsLayer
+            val parent = if (movesWithLogo) homeTextShift() ?: Offset.Zero else Offset.Zero
+            translationX = pos.x - start.x - parent.x
+            translationY = pos.y - start.y - parent.y + st.pageInsetY * progress.value
+            if (st.growX != 1f || st.growY != 1f) { // grows to the page's text size as it glides
+                transformOrigin = TransformOrigin(0f, 0f)
+                scaleX = 1f + (st.growX - 1f) * progress.value
+                scaleY = 1f + (st.growY - 1f) * progress.value
+            }
+        }
+    }
+
+    /** Where a piece is drawn right now (root px). */
+    private fun piecePos(st: PieceState): Offset? {
+        val start = st.from ?: return null
+        val aim = st.aim ?: return null
+        val pos = lerp(start, aim + st.drift.value, progress.value)
+        // The date keeps Home's distance from the first genre, then moves out as the other genres open between them.
+        if (st === pieces.getValue(Piece.DATE) && doorsOn()) {
+            // Placed from the first genre with Home's genres, not from the page's line, which changes as the page fills in.
+            val g = pieces.getValue(Piece.GENRE)
+            val genre = piecePos(g) ?: return pos
+            val scale = (1f + (g.growX - 1f) * progress.value) / g.growX
+            return Offset(genre.x + scale * (g.homeWidth * g.growX + doorsGap()), pos.y)
+        }
+        return pos
+    }
+
+    // ---- The genre line opening: the first genre and the date are its doors ----------------
+
+    /** How wide the page's genres are past the first one, with the dot before the date (px, page size), from Home's list (the page's own line changes while it fills in). */
+    private var doorsHidden = 0f
+    /** The page's gap between its genres and its date (px). */
+    private var genreGapPx = 0f
+    /** Nuvio Mod: off since the page writes the date first (date • duration • genres): the date is no longer the right-hand door. */
+    private const val DOORS = false
+    private fun doorsOn(): Boolean = DOORS && phase == Phase.Flying && doorsHidden > 0f && pieces.getValue(Piece.GENRE).from != null && pieces.getValue(Piece.DATE).from != null
+
+    /** How far the genre line has opened (0..1): from when the page shows. */
+    private fun doorsOpen(): Float = FastOutSlowInEasing.transform(revealT.value.coerceIn(0f, 1f))
+
+    /** On Home, from the first genre's end to the date (px, at the page's text size). */
+    private fun doorsHomeGap(): Float {
+        val g = pieces.getValue(Piece.GENRE)
+        val gf = g.from ?: return 0f
+        val df = pieces.getValue(Piece.DATE).from ?: return 0f
+        return ((df.x - gf.x - g.homeWidth) * g.growX).coerceAtLeast(0f)
+    }
+
+    /** From the first genre's end to the date now (px, the genre line's own size): Home's distance, widening to the page's. */
+    private fun doorsGap(): Float {
+        val home = doorsHomeGap()
+        return home + (doorsHidden + genreGapPx - home) * doorsOpen()
+    }
+
+    /** Home's genres as the page will write them, measured in the page's style. */
+    private fun predictDoorsHidden() {
+        doorsHidden = 0f
+        val st = pieces.getValue(Piece.GENRE)
+        val m = measurer ?: return
+        val ps = st.pageStyle ?: return
+        val first = st.homeText?.takeIf { it.isNotBlank() } ?: return
+        val full = st.homeFullText?.takeIf { it.isNotBlank() } ?: first
+        doorsHidden = (m.measure(full, ps).size.width - m.measure(first, ps).size.width + genreGapPx + m.measure("•", ps).size.width).coerceAtLeast(0f)
+        DetailEntryTrace.mark("mod_doors_guess_${doorsHidden.toInt()}_from_${full.count { it == '•' } + 1}_genres")
+    }
+
+
+    /** Called when a Home card opens [id]'s page and Home's big picture is that title's: the move starts now. */
+    fun arm(id: String) {
+        val logo = homeLogo ?: run { DetailEntryTrace.mark("mod_flight_skip_no_home_logo"); return }
+        val node = homeNode ?: return
+        job?.cancel()
+        val token = ++flightId
+        from = logo
+        fromNode = node
+        itemId = id
+        pageReady = false
+        val ctx = appContext
+        pageDescHeight = 0f // a page without a description reports none
+        val desc = pieces.getValue(Piece.DESCRIPTION).homeCoords?.takeIf { it.isAttached }?.let { homeDescription }
+        measureGrow()
+        val aim = (lastSlot ?: ctx?.let { ModHeroReserve.logoSlot(it) })?.let { slot -> predictLogoSlot(ctx, slot, desc) }
+        clearDescHold()
+        val held = if (ctx != null && !desc.isNullOrBlank() && ModHeroReserve.number(ctx, "bottom_line") != null) predictDescHeight(ctx, desc) else null
+        if (held != null && held > 0f) {
+            descHold = held
+            descHoldId = id
+            descHoldText = desc
+            descHoldJob = scope.launch {
+                kotlinx.coroutines.delay(DESC_HOLD_MS)
+                descHold = null
+            }
+        }
+        predictDoorsHidden()
+        val descH = ctx?.let { predictDescHeight(it, desc) }
+        for ((piece, st) in pieces) {
+            st.driftJob?.cancel()
+            st.driftJob = null
+            st.from = st.homeCoords?.takeIf { it.isAttached }?.positionInRoot()
+            st.homeWidth = st.homeCoords?.takeIf { it.isAttached }?.size?.width?.toFloat() ?: 0f
+            // Kept as an offset from the logo box's top (parts under the description: from its bottom); the parts between have a fixed size.
+            val rel = st.lastAim ?: ctx?.let { ModHeroReserve.point(it, piece.key) }
+            val under = if (piece.belowDescription) descH ?: 0f else 0f
+            st.aim = st.from?.let { start -> if (rel != null && aim != null) Offset(rel.x, aim.top + under + rel.y) else start }
+        }
+        // No aim yet: the target is the logo's own place, so it holds still until the page is there.
+        liveSlot = aim ?: logo
+        phase = Phase.Flying
+        DetailEntryTrace.mark("mod_flight_armed")
+        job = scope.launch {
+            try {
+                fly(waitForPage = aim == null)
+            } finally {
+                if (flightId == token) reset()
+            }
+        }
+    }
+
+    private suspend fun fly(waitForPage: Boolean) = coroutineScope {
+        progress.snapTo(0f)
+        lateIn.snapTo(0f)
+        glideTime.snapTo(0f)
+        revealT.snapTo(0f)
+        handoff.snapTo(0f)
+        drift.snapTo(Offset.Zero)
+        for (st in pieces.values) st.drift.snapTo(Offset.Zero)
+        // Each frame once the page is there: aim each piece at the page's copy; a change is glided out.
+        val track = launch {
+            while (true) {
+                withFrameNanos { }
+                if (!pageReady) continue
+                for (st in pieces.values) {
+                    if (st.from == null) continue
+                    val live = pagePieceLayoutPos(st) ?: continue
+                    val aim = st.aim
+                    if (aim == null || aim == live) { st.aim = live; continue }
+                    st.driftJob?.cancel()
+                    st.drift.snapTo(st.drift.value + (aim - live))
+                    st.aim = live
+                    st.driftJob = launch { st.drift.animateTo(Offset.Zero, tween(DRIFT_MS, easing = FastOutSlowInEasing)) }
+                }
+            }
+        }
+        val follow = launch {
+            var last = liveSlot?.topLeft
+            snapshotFlow { liveSlot?.topLeft }.collectLatest { now ->
+                val before = last
+                if (now == null || before == null || now == before) { if (now != null) last = now; return@collectLatest }
+                DetailEntryTrace.mark("mod_flight_shift_dy_${(now.y - before.y).toInt()}")
+                // Aim where it was a moment ago, then glide to the new place.
+                drift.snapTo(drift.value + (before - now))
+                last = now
+                drift.animateTo(Offset.Zero, tween(DRIFT_MS, easing = FastOutSlowInEasing))
+            }
+        }
+        val move = launch {
+            if (waitForPage) snapshotFlow { pageReady }.first { it }
+            DetailEntryTrace.mark("mod_flight_start")
+            launch { glideTime.animateTo(1f, tween(FLIGHT_MS, easing = androidx.compose.animation.core.LinearEasing)) }
+            progress.animateTo(1f, tween(FLIGHT_MS, easing = FastOutSlowInEasing))
+        }
+        // The page's lines rise in one after the other once the description has nearly landed.
+        val late = launch {
+            snapshotFlow { progress.value >= PAGE_LINES_FROM }.first { it }
+            lateIn.animateTo(1f, tween(LATE_TOTAL_MS, easing = androidx.compose.animation.core.LinearEasing))
+        }
+        if (withTimeoutOrNull(WAIT_MS) { snapshotFlow { pageReady }.first { it } } == null) {
+            DetailEntryTrace.mark("mod_flight_timeout")
+            late.cancel()
+            follow.cancel()
+            move.cancel()
+            track.cancel()
+            return@coroutineScope
+        }
+        DetailEntryTrace.mark("mod_flight_page_ready")
+        // The page's copies can't be seen before the page is built (~0.2 s in), so the opening starts then.
+        val reveal = launch { revealT.animateTo(1f, tween(REVEAL_MS, easing = androidx.compose.animation.core.LinearEasing)) }
+        val hand = launch { handoff.animateTo(1f, tween(HANDOFF_MS, easing = FastOutSlowInEasing)) }
+        move.join()
+        hand.join()
+        // A late shift finishes gliding before the page takes over.
+        snapshotFlow { drift.isRunning || drift.value != Offset.Zero }.first { !it }
+        for (st in pieces.values) st.driftJob?.join()
+        late.join()
+        reveal.join()
+        follow.cancel()
+        track.cancel()
+        val top = liveSlot?.top
+        for ((piece, st) in pieces) {
+            val aim = st.aim ?: continue
+            if (st.from == null || top == null) continue
+            val under = if (piece.belowDescription) pageDescHeight ?: 0f else 0f
+            val rel = Offset(aim.x, aim.y - top - under)
+            st.lastAim = rel
+            appContext?.let { ModHeroReserve.savePoint(it, piece.key, rel) }
+        }
+        lastSlot = liveSlot
+        val ctx = appContext
+        val kept = liveSlot
+        if (ctx != null && kept != null) com.nuvio.tv.ui.screens.detail.ModHeroReserve.saveLogoSlot(ctx, kept)
+        learnBottomLine()
+        DetailEntryTrace.mark("mod_flight_end")
+    }
+
+    /** Home -> title page while a move runs: Home stays on screen under the page. */
+    fun homeHold(fromRoute: String, toRoute: String, homeRoute: String): ExitTransition? =
+        if (phase == Phase.Flying && !pageReady && fromRoute == homeRoute && toRoute.startsWith("detail/")) {
+            fadeOut(animationSpec = tween(durationMillis = 1, delayMillis = HOME_HOLD_MS))
+        } else null
+
+    // ---- Title page ------------------------------------------------------------------------
+
+    /** In the title page's destination: calls the move off when this page isn't the title flying in. */
+    @Composable
+    fun Host(id: String?) {
+        LaunchedEffect(id) {
+            if (phase != Phase.Idle && (id == null || id != itemId)) cancel()
+            if (descHoldId != null && id != descHoldId) clearDescHold()
+        }
+        DisposableEffect(id) {
+            onDispose {
+                if (id != null && id == itemId) cancel()
+                if (id != null && id == descHoldId) clearDescHold()
+            }
+        }
+    }
+
+    private fun cancel() {
+        job?.cancel()
+        reset()
+    }
+
+    private fun reset() {
+        phase = Phase.Idle
+        pageReady = false
+        itemId = null
+        from = null
+        fromNode = null
+        liveSlot = null
+        for (st in pieces.values) {
+            st.driftJob?.cancel()
+            st.driftJob = null
+            st.from = null
+            st.aim = null
+        }
+    }
+
+    /** Where the logo picture is drawn right now (root px): from Home's logo to the page's, live. */
+    private fun flightRect(): Rect? {
+        val src = from ?: return null
+        val slot = liveSlot ?: return null
+        val dst = fitStart(slot.size, src.width, src.height) ?: return null
+        val d = drift.value
+        val target = Rect(Offset(slot.left + d.x + dst.left, slot.top + d.y + dst.top), dst.size)
+        return lerp(src, target, progress.value)
+    }
+
+    /** The page's own background and picture: see-through until Home's texts and rows have faded. */
+    fun pageAlpha(): Float = when (phase) {
+        Phase.Idle -> 1f
+        Phase.Flying -> if (pageReady && handoff.value >= 1f) 1f else 0f
+    }
+
+    /** The page's background colour, drawn through [pageAlpha]. */
+    fun Modifier.modFlightPageBackground(color: Color): Modifier = drawBehind {
+        val a = pageAlpha()
+        if (a > 0f) drawRect(color, alpha = a)
+    }
+
+    /** On the box that holds the page's logo: takes over from Home's logo mid-move and lands in place. */
+    fun Modifier.modFlightPageLogo(): Modifier = onGloballyPositioned { c ->
+        pageLogoTop = c.positionInRoot().y
+        if (phase == Phase.Flying) {
+            liveSlot = Rect(c.positionInRoot(), c.size.toSize())
+            if (!pageReady) DetailEntryTrace.mark("mod_flight_first_layout")
+            pageReady = true
+        }
+    }.graphicsLayer {
+        if (phase != Phase.Flying) return@graphicsLayer
+        if (!pageReady) { alpha = 0f; return@graphicsLayer }
+        val src = from ?: return@graphicsLayer
+        val slot = liveSlot ?: return@graphicsLayer
+        val r = flightRect() ?: return@graphicsLayer
+        val dst = fitStart(size, src.width, src.height) ?: return@graphicsLayer
+        if (dst.width <= 0f) return@graphicsLayer
+        val k = r.width / dst.width
+        transformOrigin = TransformOrigin(0f, 0f)
+        scaleX = k
+        scaleY = k
+        translationX = r.left - slot.left - k * dst.left
+        translationY = r.top - slot.top - k * dst.top
+    }
+
+    /** How far the page's block under the logo is moved with the logo (its bottom-left corner). */
+    private fun pageBlockShift(): Offset? {
+        val src = from ?: return null
+        val slot = liveSlot ?: return null
+        val r = flightRect() ?: return null
+        val dst = fitStart(slot.size, src.width, src.height) ?: return null
+        return Offset(r.left - (slot.left + dst.left), r.bottom - (slot.top + dst.bottom))
+    }
+
+    /** On the block under the page's logo: moves with the logo's bottom-left corner while Home's texts hand over. */
+    fun Modifier.modFlightPageBlock(): Modifier = onGloballyPositioned { pageBlockOuter = it }.onSizeChanged {
+        if (phase == Phase.Flying) DetailEntryTrace.mark("mod_flight_block_h_${it.height}") // trace only
+    }.graphicsLayer {
+        if (phase != Phase.Flying) return@graphicsLayer
+        alpha = if (pageReady) handoff.value else 0f
+        val shift = pageBlockShift() ?: return@graphicsLayer
+        translationX = shift.x
+        translationY = shift.y
+    }.onGloballyPositioned { pageBlockInner = it }
+
+    /** On the page's buttons and lines (not the gliding pieces): they appear as the description lands, not under it. */
+    fun Modifier.modFlightPageLate(order: Int = 0, fromAbove: Boolean = false): Modifier = graphicsLayer {
+        if (phase != Phase.Flying) return@graphicsLayer
+        val t = lateT(order)
+        alpha = t
+        translationY = (1f - t) * LATE_RISE.toPx() * (if (fromAbove) -1f else 1f) // Nuvio Mod: [fromAbove] comes down instead
+    }
+
+    /** With [modFlightPageLate] of the same [order]: the line also opens from left to right as it moves in (diagonal entrance). */
+    fun Modifier.modFlightPageWipe(order: Int): Modifier = drawWithContent {
+        if (phase != Phase.Flying) { drawContent(); return@drawWithContent }
+        clipRect(right = size.width * lateT(order)) { this@drawWithContent.drawContent() }
+    }
+
+    /** How far the [order]th late line is into its entrance (0..1, eased). */
+    private fun lateT(order: Int): Float {
+        val ms = lateIn.value * LATE_TOTAL_MS - order.coerceIn(0, LATE_LINES - 1) * LATE_STAGGER_MS
+        return FastOutSlowInEasing.transform((ms / LATE_MS).coerceIn(0f, 1f))
+    }
+
+    /**
+     * On the page's copy of a [piece] that shows more than Home's (all ratings, all genres): only the part Home
+     * showed is visible while it glides; the rest then opens out from left to right, as if from behind a window.
+     */
+    fun Modifier.modFlightPageReveal(piece: Piece, order: Int, duringGlide: Boolean = false, fromMiddle: Boolean = false, ms: Int = REVEAL_MS): Modifier = drawWithContent {
+        val st = pieces.getValue(piece)
+        if (phase != Phase.Flying || st.from == null || st.homeWidth <= 0f) { drawContent(); return@drawWithContent }
+        val start = (st.homeWidth * st.growX).coerceAtMost(size.width)
+        // [duringGlide]: opens while it glides, from when the page shows, over [ms] (at most [REVEAL_MS]); otherwise after, in its turn.
+        val t = if (duringGlide) FastOutSlowInEasing.transform((revealT.value * REVEAL_MS / ms.coerceIn(1, REVEAL_MS)).coerceIn(0f, 1f)) else lateT(order)
+        val hidden = size.width - start
+        if (piece == Piece.GENRE && doorsOn()) {
+            // The first genre and the date are doors: the other genres open out from the middle between them and move with it.
+            val half = doorsHidden / 2f * doorsOpen() // Home's genres: the page's line may still be another one
+            val mid = start + doorsHidden / 2f
+            clipRect(right = start) { this@drawWithContent.drawContent() }
+            if (half > 0f) translate(left = (doorsGap() - doorsHidden - genreGapPx) / 2f) {
+                clipRect(left = mid - half, right = (mid + half).coerceAtMost(size.width)) { this@drawWithContent.drawContent() }
+            }
+            return@drawWithContent
+        }
+        if (!fromMiddle) {
+            clipRect(right = start + hidden * t) { this@drawWithContent.drawContent() }
+        } else {
+            // [fromMiddle]: the hidden part opens from its middle outwards.
+            val mid = start + hidden / 2f
+            val half = hidden / 2f * t
+            clipRect(right = start) { this@drawWithContent.drawContent() }
+            if (half > 0f) clipRect(left = mid - half, right = mid + half) { this@drawWithContent.drawContent() }
+        }
+    }
+
+
+    /** How far below its place a late line starts its rise. */
+    val LATE_RISE = 10.dp
+
+    /** Where the page's copy of a piece is laid out (root px), leaving out the block's own move. */
+    private fun pagePieceLayoutPos(st: PieceState): Offset? {
+        val outer = pageBlockOuter?.takeIf { it.isAttached } ?: return null
+        val inner = pageBlockInner?.takeIf { it.isAttached } ?: return null
+        val c = st.pageCoords?.takeIf { it.isAttached } ?: return null
+        return outer.positionInRoot() + inner.localPositionOf(c, Offset.Zero)
+    }
+
+    /**
+     * On the page's copy of a [piece] (inside [modFlightPageBlock]): starts on Home's copy and glides to its place.
+     * [contentInsetY]: how far below this box its content is drawn (Home's copy has none).
+     */
+    fun Modifier.modFlightPagePiece(piece: Piece, contentInsetY: androidx.compose.ui.unit.Dp = androidx.compose.ui.unit.Dp(0f)): Modifier {
+        val st = pieces.getValue(piece)
+        return onGloballyPositioned { st.pageCoords = it }.graphicsLayer {
+            st.pageInsetY = contentInsetY.toPx()
+            if (phase != Phase.Flying || !pageReady) return@graphicsLayer
+            if (st.from == null) return@graphicsLayer // Home didn't show it: it comes in with the block
+            val live = pagePieceLayoutPos(st) ?: return@graphicsLayer
+            val pos = piecePos(st) ?: return@graphicsLayer
+            val parent = pageBlockShift() ?: Offset.Zero
+            translationX = pos.x - live.x - parent.x
+            translationY = pos.y - live.y - parent.y - st.pageInsetY * (1f - progress.value)
+            if (st.growX != 1f || st.growY != 1f) { // starts at Home's text size and grows with Home's copy
+                transformOrigin = TransformOrigin(0f, 0f)
+                scaleX = (1f + (st.growX - 1f) * progress.value) / st.growX
+                scaleY = (1f + (st.growY - 1f) * progress.value) / st.growY
+            }
+        }
+    }
+
+    /**
+     * How much bigger the page's description is than Home's (across: its longest line; down: its line height).
+     * Both copies have the same lines, so scaled alike they cover each other while they cross-fade.
+     */
+    private fun measureGrow() {
+        for (st in pieces.values) { st.growX = 1f; st.growY = 1f }
+        measureDescGrow(pieces.getValue(Piece.DESCRIPTION).homeCoords?.takeIf { it.isAttached }?.let { homeDescription })
+        // One-line pieces: their text in Home's style against the page's.
+        val m = measurer ?: return
+        for (piece in listOf(Piece.DATE, Piece.GENRE, Piece.RUNTIME)) {
+            val st = pieces.getValue(piece)
+            val text = st.homeText?.takeIf { it.isNotBlank() } ?: continue
+            val hs = st.homeStyle ?: continue
+            val ps = st.pageStyle ?: continue
+            val h = m.measure(text, hs).size
+            val p = m.measure(text, ps).size
+            if (h.width <= 0 || h.height <= 0) continue
+            st.growX = (p.width.toFloat() / h.width).coerceIn(0.5f, 2f)
+            st.growY = (p.height.toFloat() / h.height).coerceIn(0.5f, 2f)
+        }
+    }
+
+    private fun measureDescGrow(text: String?) {
+        val st = pieces.getValue(Piece.DESCRIPTION)
+        if (text.isNullOrBlank()) return
+        val m = measurer ?: return
+        val page = descStyle ?: return
+        val home = homeDescStyle ?: return
+        val shaped = homeShaped(text) ?: return
+        val h = m.measure(shaped, home)
+        val p = m.measure(shaped, page)
+        if (h.size.width <= 0 || h.lineCount == 0 || p.lineCount != h.lineCount) return
+        st.growX = (p.size.width.toFloat() / h.size.width).coerceIn(0.5f, 2f)
+        st.growY = ((p.size.height.toFloat() / p.lineCount) / (h.size.height.toFloat() / h.lineCount)).coerceIn(0.5f, 2f)
+    }
+
+    // ---- The page's description size, known before the page opens ------------------------------
+
+    /**
+     * The block under the page's logo is stacked from the bottom and only the description changes its height,
+     * so the logo box's top = a bottom line (learned) - the description box's height (measured from Home's text
+     * as the page lays it out: same style, width and line limit; a cut-off one is narrower and adds its frame).
+     */
+    private fun predictLogoSlot(ctx: android.content.Context?, slot: Rect, text: String?): Rect {
+        if (ctx == null) return slot
+        val bottom = ModHeroReserve.number(ctx, "bottom_line") ?: return slot
+        val box = predictDescHeight(ctx, text) ?: return slot
+        val top = bottom - box
+        DetailEntryTrace.mark("mod_flight_predicted_dy_${(top - slot.top).toInt()}")
+        return Rect(Offset(slot.left, top), slot.size)
+    }
+
+    private fun predictDescHeight(ctx: android.content.Context, text: String?): Float? {
+        if (text.isNullOrBlank()) return 0f
+        val width = ModHeroReserve.number(ctx, "desc_width")?.toInt() ?: return null
+        val lines = ModHeroReserve.number(ctx, "desc_lines")?.toInt() ?: return null
+        val (h, cut) = measureDescription(text, width, lines) ?: return null
+        val extra = ModHeroReserve.number(ctx, "desc_extra_$cut") ?: return null
+        return h + extra
+    }
+
+    /** The description's text height (px) in a box [width] wide (its text is 24 dp narrower, cut off or not), and whether it is cut off. */
+    private fun measureDescription(text: String, width: Int, lines: Int): Pair<Float, Boolean>? {
+        val m = measurer ?: return null
+        val style = descStyle ?: return null
+        val d = density ?: return null
+        // Shaped like Home's, the page's lines are set by the text itself and the box fits the longest one.
+        val shaped = homeShaped(text)
+        val r = if (shaped != null) m.measure(shaped, style, TextOverflow.Ellipsis, maxLines = lines)
+        else m.measure(text, style, TextOverflow.Ellipsis, maxLines = lines,
+            constraints = Constraints(maxWidth = (width - with(d) { DESC_FRAME.roundToPx() }).coerceAtLeast(1)))
+        return r.size.height.toFloat() to r.hasVisualOverflow
+    }
+
+    /** What the page's description box adds around its text, left and right (the frame of a cut-off one). */
+    val DESC_FRAME = 24.dp
+
+    /** Home's description style and the width it wraps at (px), as Home lays it out. */
+    private var homeDescStyle: TextStyle? = null
+    private var homeDescMaxWidth = 0
+    private val shapedCache = object : java.util.LinkedHashMap<String, String>(16, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<String, String>?) = size > 24
+    }
+
+    /** On Home's description: remembers its style and the width it wraps at. */
+    fun Modifier.modFlightHomeDescShape(style: TextStyle): Modifier = layout { measurable, constraints ->
+        if (homeDescStyle != style || (constraints.hasBoundedWidth && constraints.maxWidth != homeDescMaxWidth)) shapedCache.clear()
+        homeDescStyle = style
+        if (constraints.hasBoundedWidth) homeDescMaxWidth = constraints.maxWidth
+        val p = measurable.measure(constraints)
+        layout(p.width, p.height) { p.place(0, 0) }
+    }
+
+    /**
+     * [text] broken into lines at the very words Home breaks it (Home's text is smaller, and letters don't scale
+     * evenly between sizes, so a scaled width alone can't match), or null before Home has shown a description.
+     */
+    fun homeShaped(text: String): String? {
+        shapedCache[text]?.let { return it }
+        val m = measurer ?: return null
+        val style = homeDescStyle ?: return null
+        val w = homeDescMaxWidth.takeIf { it > 0 } ?: return null
+        val r = m.measure(text, style, constraints = Constraints(maxWidth = w))
+        val shaped = (0 until r.lineCount).joinToString("\n") { text.substring(r.getLineStart(it), r.getLineEnd(it, visibleEnd = true)).trimEnd() }
+        shapedCache[text] = shaped
+        return shaped
+    }
+
+    /** The page's description box width for [shaped] text: its longest line plus the frame. */
+    @Composable
+    fun pageDescBoxWidth(shaped: String): androidx.compose.ui.unit.Dp {
+        val m = androidx.compose.ui.text.rememberTextMeasurer()
+        val style = androidx.tv.material3.MaterialTheme.typography.bodyMedium
+        val px = remember(shaped, style) { m.measure(shaped, style).size.width }
+        return with(LocalDensity.current) { px.toDp() } + 2.dp + DESC_FRAME // 2 dp: rounding room, so no line wraps again
+    }
+
+    /** On the page's description box: learns its width, line limit and what the box adds around the text. */
+    @Composable
+    fun Modifier.modFlightDescBox(text: String, lines: Int, cut: Boolean): Modifier {
+        val ctx = LocalContext.current.applicationContext
+        val density = LocalDensity.current
+        val hold = descHold
+        val holding = hold != null && text.trim() != descHoldText?.trim()
+        if (holding) androidx.compose.runtime.LaunchedEffect(Unit) { DetailEntryTrace.mark("mod_flight_desc_held") }
+        return onSizeChanged { size ->
+            pageDescHeight = size.height.toFloat()
+            if (holding) return@onSizeChanged // a held box teaches nothing
+            ModHeroReserve.saveNumber(ctx, "desc_width", size.width.toFloat())
+            ModHeroReserve.saveNumber(ctx, "desc_lines", lines.toFloat())
+            val (h, c) = measureDescription(text, size.width, lines) ?: return@onSizeChanged
+            if (c == cut) ModHeroReserve.saveNumber(ctx, "desc_extra_$c", size.height - h)
+        }.then(if (holding && hold != null) Modifier.height(with(density) { hold.toDp() }) else Modifier)
+    }
+
+    /** Logo box top + description box height = the block's bottom line (same for every title); learned when a glide ends. */
+    private fun learnBottomLine() {
+        val ctx = appContext ?: return
+        val top = pageLogoTop ?: return
+        val h = pageDescHeight ?: return
+        ModHeroReserve.saveNumber(ctx, "bottom_line", top + h)
+    }
+
+    /** Where a picture of [w] x [h] is drawn in a box of [box] with "fit, centred vertically, at the start". */
+    /** Details title logo: the box takes the logo's own shape (width = [widthFraction] of the space, height at most
+     *  [maxHeight] incl. [bottomPad]), so a wide logo leaves no empty band under it. Unknown shape: the full height. */
+    fun Modifier.modLogoBox(aspect: Float?, maxHeight: androidx.compose.ui.unit.Dp, widthFraction: Float, bottomPad: androidx.compose.ui.unit.Dp, emptyBottom: Float = 0f): Modifier =
+        layout { measurable, constraints ->
+            val w = (constraints.maxWidth * widthFraction).toInt()
+            val pad = bottomPad.roundToPx()
+            val maxH = maxHeight.roundToPx()
+            val known = aspect != null && aspect > 0f
+            val h = if (known) minOf(maxH, (w / aspect!!).toInt() + pad) else maxH
+            val p = measurable.measure(androidx.compose.ui.unit.Constraints.fixed(w, h))
+            // The picture fills the box's height (it has the logo's shape, or is limited by height), so its
+            // transparent bottom rows are this tall on screen: the line below moves up over them.
+            val cut = if (known) ((h - pad) * emptyBottom.coerceIn(0f, 0.6f)).toInt() else 0
+            layout(w, h - cut) { p.place(0, 0) }
+        }
+
+    private val logoEmptyBottom = java.util.concurrent.ConcurrentHashMap<String, Float>()
+    fun knownLogoEmptyBottom(url: String?): Float = url?.let { logoEmptyBottom[it] } ?: 0f
+    /** Share of the logo picture's height that is fully transparent at its bottom (measured once per logo). */
+    suspend fun measureLogoEmptyBottom(url: String, image: coil3.Image?): Float? {
+        logoEmptyBottom[url]?.let { return it }
+        val bmp = (image as? coil3.BitmapImage)?.bitmap ?: return null
+        return kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.Default) {
+            val b = if (bmp.config == android.graphics.Bitmap.Config.HARDWARE) bmp.copy(android.graphics.Bitmap.Config.ARGB_8888, false) ?: return@withContext null else bmp
+            val w = b.width; val h = b.height
+            if (w <= 0 || h <= 0) return@withContext null
+            val row = IntArray(w)
+            var empty = 0
+            for (y in h - 1 downTo 0) {
+                b.getPixels(row, 0, w, 0, y, w, 1)
+                if (row.any { (it ushr 24) > 24 }) break
+                empty++
+            }
+            if (b !== bmp) b.recycle()
+            (empty.toFloat() / h).also { logoEmptyBottom[url] = it }
+        }
+    }
+
+
+    private fun fitStart(box: Size, w: Float, h: Float): Rect? {
+        if (w <= 0f || h <= 0f || box.width <= 0f || box.height <= 0f) return null
+        val scale = minOf(box.width / w, box.height / h)
+        val dw = w * scale
+        val dh = h * scale
+        return Rect(Offset(0f, (box.height - dh) / 2f), Size(dw, dh))
+    }
+}
