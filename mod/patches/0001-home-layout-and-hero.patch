+private var modComingUpOpening: kotlinx.coroutines.Job? = null
+
+/**
+ * Nuvio Mod: a Coming up card that has aired goes straight to its episode's streams. The card itself has no
+ * episode id, so it comes from the Upcoming row's own card when there is one, else from the Calendar.
+ */
+internal fun HomeViewModel.modOpenComingUp(info: NextUpInfo, open: (com.nuvio.tv.core.calendar.CalendarWatchTarget?) -> Unit) {
+    if (modComingUpOpening?.isActive == true) return
+    modComingUpOpening = viewModelScope.launch {
+        val upcoming = _uiState.value.upcomingItems.firstNotNullOfOrNull { item ->
+            (item as? ContinueWatchingItem.NextUp)?.info?.takeIf {
