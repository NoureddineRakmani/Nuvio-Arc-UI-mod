+/**
+ * Nuvio Mod: opening a title from Home, its logo and text block move from where they are on Home to
+ * where they are on the title's page, instead of disappearing and reappearing (Nuvio v2 only).
+ *
+ * How: both screens show the same picture, so Home stays visible underneath a see-through page.
+ * The move starts on the press: Home's own logo glides toward where the page's logo sat last time.
+ * When the page's top block is laid out, the page's logo takes over at exactly that point and finishes
+ * the move to its real place; the block under it (buttons, ratings, description) rises with it while
+ * fading in. Home's texts leave with the logo from the press and fade out, as do Home's rows. If the page takes too long, the move is called off and
+ * the page appears as before. The first title after the app starts has no "last time": it waits for
+ * the page.
+ *
+ * The page's top block is stacked from the bottom, so when something under the logo appears mid-move
+ * (buttons, ratings, a credit line), the logo is pushed up. The move follows the logo's live place and
+ * glides such a shift out ([drift]) instead of letting the logo and block jump.
+ *
+ * Arc's files only carry one-line calls to this file.
+ */
+internal object ModHeroFlight {
+    /** How long after the press the page's top block may take before the move is called off. */
+    private const val WAIT_MS = 1200L
+    /** How long the move lasts. */
+    private const val FLIGHT_MS = 500
+    /** Home's texts and rows are gone by this point of the move (they leave with the logo, from the press). */
+    private const val HOME_GONE_AT = 0.5f
+    /** Home's lines under the title (genre, age rating...) are gone by this point, before the description glides over them. */
+    private const val HOME_LINES_GONE_AT = 0.3f
+    /** The page's buttons and lines appear from this point, once the description has nearly reached its place. */
+    private const val PAGE_LINES_FROM = 0.8f
+    /** Each of the page's lines rises into place over this, one after the other ([LATE_STAGGER_MS] apart). */
+    private const val LATE_MS = 380
+    private const val LATE_STAGGER_MS = 60
+    private const val LATE_LINES = 5
+    private const val LATE_TOTAL_MS = LATE_MS + LATE_STAGGER_MS * (LATE_LINES - 1)
+    private val lateIn = Animatable(0f)
+    /** The move's time (0..1, linear), beside [progress] (eased): what ends exactly as the move lands follows this. */
+    private val glideTime = Animatable(0f)
+    /** Ratings and genres opening out (time, 0..1 linear): from the moment the page's copies can be seen, over [REVEAL_MS]. */
+    private val revealT = Animatable(0f)
+    private const val REVEAL_MS = 450
+    /** Once the page is there, Home's texts hand over to the page's (cross-fade) over this. */
+    private const val HANDOFF_MS = 260
+    /** How long a shift of the page's layout takes to be glided out. */
+    private const val DRIFT_MS = 260
+    /** Home is kept on screen (under the page) for the whole move. */
+    private const val HOME_HOLD_MS = (WAIT_MS + HANDOFF_MS + DRIFT_MS + 150).toInt()
+
+    private enum class Phase { Idle, Flying }
+    private var phase by mutableStateOf(Phase.Idle)
+    /** The page's logo is laid out and has taken over from Home's. */
+    private var pageReady by mutableStateOf(false)
+    private val progress = Animatable(0f)
+    private val handoff = Animatable(0f)
+    /** The part of a layout shift not glided out yet: the target is the live place + this. */
+    private val drift = Animatable(Offset.Zero, Offset.VectorConverter)
+    private var itemId: String? = null
+    private var flightId = 0
+    private var job: Job? = null
+    /** Animations need a frame clock: the UI dispatcher's. */
+    private val scope by lazy { CoroutineScope(AndroidUiDispatcher.Main) }
+
+    /** Home's logo as drawn (root px) and its box's corner, kept up to date while Home shows one. */
+    private var homeLogo: Rect? = null
+    private var homeNode: Offset? = null
+    /** The flight: Home's logo when the card was pressed, and the page's logo box (live). */
+    private var from: Rect? = null
+    private var fromNode: Offset? = null
+    private var liveSlot by mutableStateOf<Rect?>(null)
+    /** Where the page's logo box ended last time: the first aim of the next move. */
+    private var lastSlot: Rect? = null
+    /** For keeping [lastSlot] on the device (so the first glide after the app starts has an aim too). */
