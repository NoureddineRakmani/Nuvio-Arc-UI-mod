+package com.nuvio.tv.ui.screens.home
+
+import androidx.compose.animation.core.AnimationState
+import androidx.compose.animation.core.CubicBezierEasing
+import androidx.compose.animation.core.Easing
+import androidx.compose.animation.core.animateTo
+import androidx.compose.animation.core.tween
+import androidx.compose.foundation.gestures.scrollBy
+import androidx.compose.foundation.lazy.LazyListState
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.graphicsLayer
+import java.util.WeakHashMap
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+
+/**
+ * Nuvio Mod: Up/Down on Home slides the rows by the exact distance to the next row, so the move is the same
+ * smooth slide both ways (like Apple TV). Arc's own slide (animateScrollToItem) has to guess how far a row it
+ * hasn't laid out yet is, rushes, then corrects once the row shows: the old row vanished in one frame going
+ * down, the new one popped in going up.
+ *
+ * Every row ends its move where the focused row was resting (rows hold their cards at their bottom, so the
+ * item's bottom edge is where the cards are). The slide has a fixed length and no slow tail (a spring's last
+ * pixels kept the list "scrolling" ~0.5 s after it looked still, and Home's picture waits for still rows).
+ */
+internal object ModHomeRowGlide {
+    /**
+     * Space between Home rows. Each row fills the rows area, with its cards at its bottom and the area's last
+     * [MODERN_ROW_CARD_BOTTOM_ROOM] left for the focused card to grow into; a gap of that room puts the next
+     * row's top exactly at the area's bottom edge, and the row above is already out at the top.
+     */
+    val ROW_GAP = MODERN_ROW_CARD_BOTTOM_ROOM
+    private const val GLIDE_MS = 280
+    private fun <T> slideSpec() = tween<T>(GLIDE_MS, easing = GLIDE_EASING)
+    /** The hero title block's move between rows of different card heights: starts and ends with the rows. */
+    fun <T> heroBlockSpec() = slideSpec<T>()
+    /**
+     * The row an Up/Down press is heading to, from the press until focus lands there (focus moves only once the
+     * slide ends), so the hero block moves together with the rows instead of after them.
+     */
+    val headingRowKey = androidx.compose.runtime.mutableStateOf<String?>(null)
+    /** A leaving row is fully faded after this share of the distance to the rows area's top: 0.7 still left a
+     *  faded strip of it between the hero text and the new row during the move (screen recording 2026-11-28). */
+    private const val FADE_SHARE = 0.35f
+    /** Even speed with soft ends: on a box running animations at 0.5x the slide has ~9 frames, and this curve
+     *  keeps the biggest step per frame low (63 px instead of 88 for a row), so it reads as a slide, not a jump. */
+    private val GLIDE_EASING = CubicBezierEasing(0.33f, 0f, 0.67f, 1f)
+
+    private class Glide {
+        /** Where a resting row's bottom edge is (px from the top of the rows area). */
+        var restBottom: Float? = null
+        /** A slide is under way or was cut short by the next press (its row never came to rest). */
+        var unfinished = false
+    }
+    private val glides = WeakHashMap<LazyListState, Glide>()
+
+    /** One of these slides is moving the rows: Arc's bring-into-view leaves the list alone meanwhile. */
+    var gliding = false
+        private set
+
+    // ---- Letting go of a held Up/Down -----------------------------------------------------------
+
+    /**
+     * After a held Up/Down: the row to land on, the next one in the direction of travel (Arc's choice could
+     * be the row behind, so the rows went back). [restFallback]: where a row rests if no press taught it yet.
+     */
+    fun LazyListState.modHoldLandingRow(sign: Int, restFallback: Float): Int? {
+        val rest = glides[this]?.restBottom ?: restFallback
+        val items = layoutInfo.visibleItemsInfo
+        return if (sign > 0) items.firstOrNull { it.offset + it.size >= rest - 1f }?.index
+        else items.lastOrNull { it.offset + it.size <= rest + 1f }?.index
+    }
+
+    /** Slides the row at [targetIndex] to its resting place, starting at the held drag's [speedPxPerSec]. */
+    fun CoroutineScope.modLandAfterHold(state: LazyListState, targetIndex: Int, speedPxPerSec: Float, restFallback: Float) {
+        val g = glides.getOrPut(state) { Glide() }
+        val rest = g.restBottom ?: restFallback
+        val item = state.layoutInfo.visibleItemsInfo.firstOrNull { it.index == targetIndex } ?: return
+        val distance = (item.offset + item.size) - rest
+        if (kotlin.math.abs(distance) < 1f) return
+        // Starts at the drag's speed and slows evenly to a stop: x = d(1 - (1 - t)^2) starts at 2d/T.
+        val ms = (2000f * kotlin.math.abs(distance) / speedPxPerSec).toInt().coerceIn(120, 450)
+        launch {
+            var done = 0f
+            gliding = true
+            try {
+                state.scroll {
+                    AnimationState(0f).animateTo(distance, tween(ms, easing = EASE_OUT_FROM_SPEED), sequentialAnimation = true) {
+                        scrollBy(value - done)
+                        done = value
+                    }
+                }
+            } finally {
+                gliding = false
+            }
+        }
+    }
+    private val EASE_OUT_FROM_SPEED = Easing { t -> 1f - (1f - t) * (1f - t) }
+
+    /** Slides [this] list so the row at [targetIndex] rests where the row at [fromIndex] rests (or was heading to). */
+    suspend fun LazyListState.modGlideToRow(fromIndex: Int, targetIndex: Int, gapPx: Float) {
+        val g = glides.getOrPut(this) { Glide() }
+        val items = layoutInfo.visibleItemsInfo
+        val from = items.firstOrNull { it.index == fromIndex }
+        if (!g.unfinished && from != null) g.restBottom = (from.offset + from.size).toFloat()
+        val rest = g.restBottom ?: return animateScrollToItem(targetIndex)
+        val target = items.firstOrNull { it.index == targetIndex }
+        val targetBottom = when {
+            target != null -> (target.offset + target.size).toFloat()
+            // Not laid out yet: rows in between are the same height as this one.
+            from != null -> from.offset + from.size + (targetIndex - fromIndex) * (from.size + gapPx)
+            else -> return animateScrollToItem(targetIndex)
+        }
+        val distance = targetBottom - rest
+        if (kotlin.math.abs(distance) < 1f) { g.unfinished = false; return }
+        var done = 0f
+        g.unfinished = true
+        gliding = true
+        try {
+            scroll {
+                AnimationState(0f).animateTo(distance, slideSpec(), sequentialAnimation = true) {
+                    scrollBy(value - done)
+                    done = value
+                }
+            }
+        } finally {
+            gliding = false
+        }
+        g.unfinished = false
+    }
+
+    /**
+     * A row moving up out of the rows area fades away by the time its cards reach the area's top (the tallest
+     * cards sit [MODERN_ROW_HEADER_FOCUS_INSET] below it), so it never slides across the hero text; going up,
+     * the row arriving from above fades in the same way. Resting rows (offset 0) and rows below stay opaque.
+     */
+    fun Modifier.modRowFade(state: LazyListState, index: Int): Modifier = graphicsLayer {
+        // A row the list no longer counts as visible can still be drawn: the focused row stays placed (pinned)
+        // above the rows area until focus reaches the new row, and it used to come back fully opaque then.
+        val top = state.layoutInfo.visibleItemsInfo.firstOrNull { it.index == index }?.offset
+        if (top == null) { alpha = 0f; return@graphicsLayer }
+        alpha = if (top >= 0) 1f else (1f + top / (MODERN_ROW_HEADER_FOCUS_INSET.toPx() * FADE_SHARE)).coerceIn(0f, 1f)
+    }
+}
