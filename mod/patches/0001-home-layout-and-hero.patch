+            com.nuvio.tv.core.calendar.CalendarWatchTarget(
+                contentId = upcoming.contentId, contentType = upcoming.contentType, name = upcoming.name,
+                poster = upcoming.poster, backdrop = upcoming.backdrop, logo = upcoming.logo, videoId = upcoming.videoId,
+                season = upcoming.season, episode = upcoming.episode, episodeTitle = upcoming.episodeTitle
+            )
+        } else {
+            try {
+                calendarComingUp?.modWatchTarget(info)
+            } catch (cancelled: kotlinx.coroutines.CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                null
+            }
+        }
+        open(target?.let { it.copy(backdrop = it.backdrop ?: info.backdrop, logo = it.logo ?: info.logo) })
+    }
+}
