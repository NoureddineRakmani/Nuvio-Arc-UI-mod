+/**
+ * Nuvio Mod: the highlight used everywhere, the same as the top menu pill: a faint white fill
+ * and a soft sheen from the upper left. [amount] fades it in and out.
+ */
+internal fun androidx.compose.ui.graphics.drawscope.DrawScope.drawModGlassHighlight(
+    outline: androidx.compose.ui.graphics.Outline,
+    amount: Float = 1f
+) {
+    if (amount <= 0f) return
+    drawOutline(outline, Color.White, alpha = com.nuvio.tv.ui.v2.appearance.MOD_FOCUS_FILL_ALPHA * amount)
+    drawOutline(
+        outline,
+        androidx.compose.ui.graphics.Brush.radialGradient(
+            0f to Color.White.copy(alpha = com.nuvio.tv.ui.v2.appearance.MOD_FOCUS_SHEEN_ALPHA * amount),
+            1f to Color.Transparent,
+            center = androidx.compose.ui.geometry.Offset(size.width * 0.28f, 0f),
+            radius = size.width.coerceAtLeast(1f) * 0.75f
+        )
+    )
+}
 
