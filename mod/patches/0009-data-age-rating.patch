@@ -0,0 +1,36 @@
+package com.nuvio.tv.data.local
+
+import com.nuvio.tv.domain.model.AccentMode
+import com.nuvio.tv.domain.model.DeviceUiPreferences
+import com.nuvio.tv.domain.model.FocusStyle
+import com.nuvio.tv.domain.model.GlassPreset
+import com.nuvio.tv.domain.model.GlassTintMode
+import com.nuvio.tv.domain.model.NavigationStyle
+import com.nuvio.tv.domain.model.PlayerChromeStyle
+import com.nuvio.tv.domain.model.SettingsBackground
+import com.nuvio.tv.domain.model.SettingsPresentation
+import com.nuvio.tv.domain.model.V2AppearancePreferences
+import com.nuvio.tv.domain.model.VisualQualityMode
+import com.nuvio.tv.domain.model.VisualStyle
+
+/**
+ * Nuvio Mod: Appearance choices fixed to the mod's look; their rows are hidden in V2PreferenceControls.
+ * Kept in settings: Experience (V2 / Original), Interface scale; the Colour theme (Theme settings) sets the accent.
+ * The glass itself (darkness, blur) is defined in ModLook and ignores Arc's glass preset; FROSTED only keeps
+ * Arc's blur switch at full strength.
+ */
+internal fun V2AppearancePreferences.modFixed(): V2AppearancePreferences = copy(
+    visualStyle = VisualStyle.CINEMATIC_GLASS,
+    navigationStyle = NavigationStyle.TOP_NAVIGATION,
+    focusStyle = FocusStyle.GLASS_LIFT,
+    accentMode = AccentMode.FIXED_THEME, // the accent is the Colour theme's colour (it also colours the highlight)
+    glassTintMode = GlassTintMode.NEUTRAL,
+    settingsPresentation = SettingsPresentation.GLASS,
+    settingsBackground = SettingsBackground.HERO,
+    playerChromeStyle = PlayerChromeStyle.INVISIBLE,
+    introAnimationEnabled = false,
+    introSoundEnabled = false
+).withGlassPreset(GlassPreset.FROSTED)
+
+/** Nuvio Mod: blur always on, no Maximum extras (Home trailer re-blur), no automatic level changes. */
+internal fun DeviceUiPreferences.modFixed(): DeviceUiPreferences = copy(visualQualityMode = VisualQualityMode.ENHANCED)
