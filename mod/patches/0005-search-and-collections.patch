+package com.nuvio.tv.ui.navigation
+
+import androidx.navigation.NavController
+import com.nuvio.tv.core.performance.DetailEntryTrace
+import com.nuvio.tv.ui.screens.calendar.openCalendarWatchTarget
+import com.nuvio.tv.ui.screens.home.ContinueWatchingItem
+import com.nuvio.tv.ui.screens.home.HeroBackdropState
+import com.nuvio.tv.ui.screens.home.HomeViewModel
+import com.nuvio.tv.ui.screens.home.ModDetailSeed
+import com.nuvio.tv.ui.screens.home.ModStreamSeed
+import com.nuvio.tv.ui.screens.home.modOpenComingUp
+import com.nuvio.tv.ui.screens.home.modShownHeroFor
+
+/*
+ * Nuvio Mod: what the mod adds to the way Home opens other pages. Kept here, out of NuvioNavHost.kt,
+ * so Arc's own navigation file only carries one-line calls to these.
+ */
+
+/**
+ * Nuvio Mod: if Home's big picture is this title's, hand it to the details page (the decoded picture
+ * itself, so the page never opens on a dark screen). Returns the picture's address, for the page to
+ * know its backdrop at once.
+ */
+internal fun modOfferHeroToDetail(itemId: String, itemType: String): String? {
+    val hero = modShownHeroFor(itemId)
+    ModDetailSeed.offer(itemId, itemType, hero?.second)
+    return hero?.first
+}
+
+/** Nuvio Mod: Home's way into a details page (as in NuvioNavHost), opened on one episode. */
+private fun NavController.modOpenDetailOnEpisode(itemId: String, itemType: String, season: Int?, episode: Int?) {
+    DetailEntryTrace.begin()
+    val heroArtwork = HeroBackdropState.consumeArtworkForTitle(itemId, itemType)
+    val modHeroUrl = modOfferHeroToDetail(itemId, itemType)
+    navigate(
+        Screen.Detail.createRoute(
+            itemId = itemId,
+            itemType = itemType,
+            addonBaseUrl = "",
+            heroBackdropUrl = heroArtwork?.backdropUrl ?: modHeroUrl,
+            heroLogoUrl = heroArtwork?.logoUrl,
+            returnFocusSeason = season,
+            returnFocusEpisode = episode
+        )
+    )
+}
+
+/**
+ * Nuvio Mod: a Home "Coming up" card carries no episode id. Look the episode up and open its streams
+ * (out or not by its air date: premium sources can have episodes early); if no episode id is found,
+ * open the show's page on that episode. Returns false for any other card, which Arc then handles.
+ * Trace marks: mod_comingup_S<s>E<e>_out_<bool>, then mod_comingup_streams / mod_comingup_no_episode_id.
+ */
+internal fun NavController.modOpenComingUpCard(item: ContinueWatchingItem, homeViewModel: HomeViewModel): Boolean {
+    val info = (item as? ContinueWatchingItem.NextUp)?.info?.takeIf { it.comingUpKey != null && it.videoId.isBlank() }
+        ?: return false
+    DetailEntryTrace.begin()
+    DetailEntryTrace.mark("mod_comingup_S${info.season}E${info.episode}_out_${info.hasAired}")
+    val series = info.contentType.equals("series", ignoreCase = true)
+    homeViewModel.modOpenComingUp(info) { target ->
+        if (currentDestination?.route != Screen.Home.route) return@modOpenComingUp
+        if (target?.videoId != null) {
+            DetailEntryTrace.mark("mod_comingup_streams")
+            ModStreamSeed.offerFromHome(target.contentId)
+            openCalendarWatchTarget(target)
+        } else {
+            DetailEntryTrace.mark("mod_comingup_no_episode_id")
+            modOpenDetailOnEpisode(
+                info.contentId, info.contentType,
+                season = info.season.takeIf { series && it > 0 },
+                episode = info.episode.takeIf { series && info.season > 0 }
+            )
+        }
+    }
+    return true
+}
