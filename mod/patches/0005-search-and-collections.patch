--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/ui/screens/search/ModSearchCollections.kt
@@ -0,0 +1,37 @@
+package com.nuvio.tv.ui.screens.search
+
+import android.content.Context
+import coil3.imageLoader
+import coil3.request.CachePolicy
+import coil3.request.ImageRequest
+import com.nuvio.tv.domain.model.Collection
+
+/**
+ * Nuvio Mod: collections are shown on the search page, not on Home. Home still reads them when the
+ * app starts; this keeps that list so the search page has it on its first frame, and downloads the
+ * folder cover pictures in the background so they are stored before Search opens (as they were
+ * when Home drew them). Focus GIFs are left to load on focus; folder contents are not touched.
+ */
+internal object ModSearchCollections {
+    @Volatile var last: List<Collection>? = null
+    /** Recent searches, read by Home when the app starts, so the search page has them on its first frame. */
+    @Volatile var recentSearches: List<String>? = null
+    private val warmed = java.util.Collections.synchronizedSet(mutableSetOf<String>())
+
+    fun visible(list: List<Collection>): List<Collection> = list.filter { it.folders.isNotEmpty() }
+
+    fun keep(list: List<Collection>, context: Context) {
+        last = list
+        val loader = context.imageLoader
+        list.asSequence()
+            .flatMap { it.folders.asSequence() }
+            .mapNotNull { folder -> folder.coverImageUrl?.takeIf { it.isNotBlank() } }
+            .filter { warmed.add(it) }
+            .forEach { url ->
+                // Disk only: the tile decodes at its own size when drawn.
+                loader.enqueue(
+                    ImageRequest.Builder(context).data(url).memoryCachePolicy(CachePolicy.DISABLED).build()
+                )
+            }
+    }
+}
