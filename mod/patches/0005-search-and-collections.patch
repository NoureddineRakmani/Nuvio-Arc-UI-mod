+/** Nuvio Mod: recent searches as a single line of pills under the search field. */
+@Composable
+private fun ModRecentSearchPills(
+    recentSearches: List<String>,
+    onSearchSelected: (String) -> Unit,
+    onClearHistory: () -> Unit,
+    onSectionFocusChanged: (Boolean) -> Unit,
+    clearHistoryFocusRequester: FocusRequester,
+    modifier: Modifier = Modifier
+) {
+    val pillShape = RoundedCornerShape(50)
+    val pillColors = ButtonDefaults.colors(
+        containerColor = Color.White.copy(alpha = 0.08f),
+        contentColor = NuvioTheme.colors.TextSecondary,
+        focusedContainerColor = Color.White.copy(alpha = 0.08f), // Nuvio Mod: soft highlight instead of solid white
+        focusedContentColor = NuvioTheme.colors.TextPrimary
+    )
+    Row(
+        modifier = modifier
+            .fillMaxWidth()
+            .focusGroup()
+            .onFocusChanged { state -> onSectionFocusChanged(state.hasFocus || state.isFocused) },
+        horizontalArrangement = Arrangement.spacedBy(12.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        recentSearches.take(6).forEach { recentQuery ->
+            key(recentQuery) {
+                var pillFocused by remember { mutableStateOf(false) }
+                Button(
+                    onClick = { onSearchSelected(recentQuery) },
+                    modifier = Modifier.onFocusChanged { pillFocused = it.isFocused }
+                        .modMenuPillHighlight(pillFocused, pillShape),
+                    shape = ButtonDefaults.shape(pillShape),
+                    colors = pillColors
+                ) {
+                    Text(text = recentQuery, maxLines = 1)
+                }
+            }
+        }
+        var clearFocused by remember { mutableStateOf(false) }
+        Button(
+            onClick = onClearHistory,
+            modifier = Modifier.focusRequester(clearHistoryFocusRequester)
+                .onFocusChanged { clearFocused = it.isFocused }
+                .modMenuPillHighlight(clearFocused, pillShape),
+            shape = ButtonDefaults.shape(pillShape),
+            colors = pillColors
+        ) {
+            Text(text = stringResource(R.string.search_recent_clear), maxLines = 1)
+        }
+    }
+}
+
+/**
+ * Nuvio Mod: the top menu pill's highlight (faint white fill + soft sheen from the upper left,
+ * no edge line), drawn behind the content when [focused].
+ */
+private fun Modifier.modMenuPillHighlight(focused: Boolean, shape: androidx.compose.ui.graphics.Shape): Modifier =
+    if (!focused) this else this.then(
+        Modifier.drawBehind {
+            val outline = shape.createOutline(size, layoutDirection, this)
+            drawOutline(outline, Color.White, alpha = 0.07f)
+            drawOutline(
+                outline,
+                androidx.compose.ui.graphics.Brush.radialGradient(
+                    0f to Color.White.copy(alpha = 0.08f),
+                    1f to Color.Transparent,
+                    // Sized from the height, so the sheen looks the same on a wide bar as on a menu pill
+                    // (on a menu pill, about 4x as wide as tall, these equal 28% and 75% of the width).
+                    center = androidx.compose.ui.geometry.Offset(minOf(size.width * 0.28f, size.height * 1.12f), 0f),
+                    radius = minOf(size.width * 0.75f, size.height * 3f).coerceAtLeast(1f)
+                )
+            )
+        }
+    )
